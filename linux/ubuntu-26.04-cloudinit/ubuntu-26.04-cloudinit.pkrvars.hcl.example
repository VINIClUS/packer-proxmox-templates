# Optional target-specific defaults for the Ubuntu 26.04 cloud-init template.
# Copy values into a local ignored vars file or pass this file to the script.

vm_id                         = 9202
vm_name                       = "ubuntu-26-04-cloudinit-packer"
template_name                 = "tpl-ubuntu-26-04-cloudinit"
template_description          = "Ubuntu Server 26.04 LTS Resolute cloud-init template for Proxmox."
template_label                = "Ubuntu 26.04 LTS"
template_tags                 = "ubuntu;resolute;cloudinit;template"

cpu_cores                     = 2
cpu_sockets                   = 1
memory_mb                     = 2048
disk_size                     = "20G"

cloud_image_url               = "https://cloud-images.ubuntu.com/releases/server/server/26.04/release/ubuntu-26.04-server-cloudimg-amd64.img"
cloud_image_directory         = "/var/lib/vz/template/qcow2"
cloud_image_file              = "ubuntu-26.04-server-cloudimg-amd64.img"
cloud_image_checksum_file     = "SHA256SUMS"
cloud_image_checksum_type     = "sha256"

cloud_init_storage_pool       = "local-lvm"
cloud_init_user               = "ubuntu"
ssh_keys_file                 = ""
