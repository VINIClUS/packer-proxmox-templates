# Optional target-specific defaults for the AlmaLinux 10 cloud-init template.
# Copy values into a local ignored vars file or pass this file to the script.

vm_id                         = 9201
vm_name                       = "almalinux-10-cloudinit-packer"
template_name                 = "tpl-almalinux-10-cloudinit"
template_description          = "AlmaLinux 10.1 GenericCloud cloud-init template for Proxmox."
template_label                = "AlmaLinux 10.1"
template_tags                 = "almalinux;el10;cloudinit;template"

cpu_cores                     = 2
cpu_sockets                   = 1
memory_mb                     = 2048
disk_size                     = "16G"

cloud_image_url               = "https://repo.almalinux.org/almalinux/10.1/cloud/x86_64_v2/images/AlmaLinux-10-GenericCloud-latest.x86_64_v2.qcow2"
cloud_image_directory         = "/var/lib/vz/template/qcow2"
cloud_image_file              = "AlmaLinux-10-GenericCloud-latest.x86_64_v2.qcow2"
cloud_image_checksum_file     = "CHECKSUM"
cloud_image_checksum_type     = "sha256"

cloud_init_storage_pool       = "local-lvm"
cloud_init_user               = "almalinux"
ssh_keys_file                 = ""
