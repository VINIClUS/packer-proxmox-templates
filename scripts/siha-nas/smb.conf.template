[global]
   server string = SIHA internal NAS
   workgroup = WORKGROUP
   security = user
   map to guest = Never
   restrict anonymous = 2
   usershare allow guests = no

   # SMB1 is intentionally disabled.
   server min protocol = SMB2_10
   client min protocol = SMB2_10
   server signing = default

   log file = /var/log/samba/log.%m
   max log size = 10000
   logging = file

   load printers = no
   printing = bsd
   printcap name = /dev/null
   disable spoolss = yes

[SIHA]
   comment = SIHA faturamento SUS - operacional, historico, backups e manifestos
   path = /dados/siha
   browseable = yes
   read only = no
   valid users = @siha_faturamento
   force group = siha_faturamento
   create mask = 0660
   directory mask = 2770
   force create mode = 0660
   force directory mode = 2770
   inherit permissions = yes
   vfs objects = recycle
   recycle:repository = .lixeira/%U
   recycle:keeptree = yes
   recycle:versions = yes
   recycle:touch = yes
   recycle:exclude = *.tmp,*.temp,~$*,*.lock,*.lck
   recycle:exclude_dir = .lixeira,tmp,cache

[SIHA_BACKUPS]
   comment = SIHA backups dos sistemas de faturamento
   path = /dados/siha/03_BACKUPS_SISTEMAS
   browseable = yes
   read only = no
   valid users = @siha_faturamento
   force group = siha_faturamento
   create mask = 0660
   directory mask = 2770
   force create mode = 0660
   force directory mode = 2770
   inherit permissions = yes
   vfs objects = recycle
   recycle:repository = .lixeira/%U
   recycle:keeptree = yes
   recycle:versions = yes

[SIHA_ARQUIVO]
   comment = SIHA arquivo fechado - leitura operacional preferencial
   path = /dados/siha/90_ARQUIVO_FECHADO
   browseable = yes
   read only = yes
   valid users = @siha_faturamento
   force group = siha_faturamento
   create mask = 0660
   directory mask = 2770
