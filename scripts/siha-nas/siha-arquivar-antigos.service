[Unit]
Description=SIHA NAS archival report for old files
Documentation=file:/opt/siha-nas/README.md

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/arquivar-antigos-siha.sh --base /dados/siha --older-than-days 730 --report-only
User=root
Group=root
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
