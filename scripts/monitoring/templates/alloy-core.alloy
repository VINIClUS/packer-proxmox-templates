// Alloy baseline configuration for the monitoring-core container.
logging {
  level = "info"
  format = "logfmt"
}

prometheus.exporter.unix "core" {
  include_exporter_metrics = true
}

prometheus.scrape "core_unix" {
  targets    = prometheus.exporter.unix.core.targets
  forward_to = [prometheus.relabel.core_unix.receiver]
}

prometheus.relabel "core_unix" {
  forward_to = [prometheus.remote_write.local.receiver]

  rule {
    target_label = "job"
    replacement  = "monitoring-core-unix"
  }

  rule {
    target_label = "host"
    replacement  = "monitoring-core"
  }

  rule {
    target_label = "ctid"
    replacement  = "190"
  }
}

prometheus.remote_write "local" {
  endpoint {
    // Task 3 provisioner must start CT 190 Prometheus with
    // --web.enable-remote-write-receiver so this local write endpoint accepts samples.
    url = "http://127.0.0.1:9090/api/v1/write"
  }
}

loki.source.journal "core" {
  forward_to = [loki.write.local.receiver]

  labels = {
    job  = "monitoring-core-journal"
    host = "monitoring-core"
    ctid = "190"
  }
}

loki.write "local" {
  endpoint {
    url = "http://127.0.0.1:3100/loki/api/v1/push"
  }
}
