# WAL-G continuous archiving and weekly full backups. Store operational metadata
# in Infisical /test; WAL-G reuses the object-storage backup access key.
ESUS_PEC_WALG_ENABLED=true
ESUS_PEC_WALG_VERSION=v3.0.8
ESUS_PEC_WALG_S3_PREFIX=s3://esus-pec-backups/wal-g/ct133
ESUS_PEC_WALG_AWS_ENDPOINT=https://192.168.1.210:9000
ESUS_PEC_WALG_AWS_REGION=us-east-1
ESUS_PEC_WALG_RETENTION_FULL=4
ESUS_PEC_WALG_FULL_BACKUP_SCHEDULE=Sun 02:00:00 America/Sao_Paulo
ESUS_PEC_WALG_ARCHIVE_TIMEOUT_SECONDS=60
ESUS_PEC_WALG_ARCHIVE_COMMAND=/usr/local/bin/esus-pec-walg-wal-push %p
ESUS_PEC_WALG_BACKUP_SERVICE=esus-pec-walg-full-backup.service
ESUS_PEC_WALG_BACKUP_TIMER=esus-pec-walg-full-backup.timer
ESUS_PEC_WALG_LAST_FULL_BACKUP=
