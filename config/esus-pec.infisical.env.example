ESUS_PEC_OBJECT_STORAGE_API_URL=https://192.168.1.210:9000
ESUS_PEC_OBJECT_STORAGE_CONSOLE_URL=https://192.168.1.210:9001
ESUS_PEC_OBJECT_STORAGE_BUCKET=esus-pec-backups
ESUS_PEC_OBJECT_STORAGE_ROOT_USER=
ESUS_PEC_OBJECT_STORAGE_ROOT_PASSWORD=
ESUS_PEC_OBJECT_STORAGE_BACKUP_ACCESS_KEY=
ESUS_PEC_OBJECT_STORAGE_BACKUP_SECRET_KEY=
